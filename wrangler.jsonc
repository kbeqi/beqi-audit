{
  "$schema": "node_modules/wrangler/config-schema.json",
  // "beqi-audit" is already taken by the public Site Check widget Worker on beqi.co.
  "name": "beqi-audit-app",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    // Public base URL of the app; used to build the Webflow OAuth redirect URI.
    "APP_URL": "http://localhost:8787"
  },
  "triggers": {
    // Scheduler tick: starts audit runs for every site whose next_run_at is due.
    "crons": ["0 * * * *"]
  },
  "services": [
    // Self-reference service binding required by OpenNext (name must match "name" above).
    { "binding": "WORKER_SELF_REFERENCE", "service": "beqi-audit-app" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beqi-audit",
      "database_id": "6bbcddcb-987a-4129-bdfd-7d980d44c939",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    // Next.js incremental cache (OpenNext).
    { "binding": "NEXT_INC_CACHE_KV", "id": "fe5ad175e469408482e53a5835071867" },
    // Audit artifacts: per-run crawl/link/PageSpeed JSON (see src/audit/store.ts).
    // Move to R2 once it is enabled on the account if screenshots/PDF reports are added.
    { "binding": "AUDIT_STORE", "id": "92fd1948a9174dfd863e15f09eec6543" }
  ],
  "browser": {
    // Browser Rendering, used for screenshots and rendered-DOM checks.
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "binding": "AUDIT_RUN",
      "name": "beqi-audit-run",
      "class_name": "AuditRunWorkflow"
    }
  ],
  "images": { "binding": "IMAGES" }
}
