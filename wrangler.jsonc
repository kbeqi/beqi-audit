{
  "$schema": "node_modules/wrangler/config-schema.json",
  // "beqi-audit" is already taken by the public Site Check widget Worker on beqi.co.
  "name": "beqi-audit-app",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    // Public base URL of the app; used to build the Webflow MCP OAuth redirect URI.
    "APP_URL": "https://beqi-audit-app.beqi.workers.dev",
    // Webflow's hosted MCP server. Claude (via the Anthropic MCP connector) and the
    // app's own site import both talk to it with the per-workspace OAuth token.
    "WEBFLOW_MCP_URL": "https://mcp.webflow.com/mcp",
    // "app": in-app sign-in by one-time email link; only people on the Team page
    // (or ADMIN_EMAILS) can sign in. "access": trust Cloudflare Access's identity
    // header instead (must still be a team member). "open": no sign-in; bring-up
    // only, the UI shows a warning banner.
    "AUTH_MODE": "app",
    // Always admins, even with an empty users table: the lockout safety net.
    "ADMIN_EMAILS": "kreshnik@beqi.co",
    // Sender for client emails (reminders and results) through Resend; the
    // domain must be verified in Resend. Requires the RESEND_API_KEY secret.
    "EMAIL_FROM": "Beqi Audit <audit@beqi.co>"
  },
  "triggers": {
    // Scheduler tick: starts audit runs for every site whose next_run_at is due.
    "crons": ["*/20 * * * *"]
  },
  "services": [
    // Self-reference service binding required by OpenNext (name must match "name" above).
    { "binding": "WORKER_SELF_REFERENCE", "service": "beqi-audit-app" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beqi-audit",
      "database_id": "6bbcddcb-987a-4129-bdfd-7d980d44c939",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    // Next.js incremental cache (OpenNext).
    { "binding": "NEXT_INC_CACHE_KV", "id": "fe5ad175e469408482e53a5835071867" },
    // Audit artifacts: per-run crawl/link/PageSpeed JSON (see src/audit/store.ts).
    // Move to R2 once it is enabled on the account if screenshots/PDF reports are added.
    { "binding": "AUDIT_STORE", "id": "92fd1948a9174dfd863e15f09eec6543" }
  ],
  "workflows": [
    {
      // Runs audits and approved fixes (see src/audit/workflow.ts).
      "binding": "AUDIT_RUN",
      "name": "beqi-audit-run",
      "class_name": "AuditRunWorkflow"
    }
  ]
}
