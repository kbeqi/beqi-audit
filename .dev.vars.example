# Copy to .dev.vars for local development. In production set secrets with
# `wrangler secret put <NAME>`; plain vars live in wrangler.jsonc.

# Required. The audit and fix agents run on Claude through the Anthropic API.
ANTHROPIC_API_KEY=

# Overrides the wrangler.jsonc vars in local dev.
APP_URL=http://localhost:3000
WEBFLOW_MCP_URL=https://mcp.webflow.com/mcp
AUTH_MODE=open
