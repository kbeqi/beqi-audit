# Copy to .dev.vars for local development. In production set secrets with
# `wrangler secret put <NAME>`; plain vars live in wrangler.jsonc.

# Required. The audit and fix agents run on Claude through the Anthropic API.
ANTHROPIC_API_KEY=

# Sign-in links and client emails (Resend). Without it emails are recorded as skipped.
RESEND_API_KEY=

# Overrides the wrangler.jsonc vars in local dev.
APP_URL=http://localhost:3000
WEBFLOW_MCP_URL=https://mcp.webflow.com/mcp
# "open" signs you in as dev@local without email; "app" enforces sign-in like production.
AUTH_MODE=open
ADMIN_EMAILS=kreshnik@beqi.co

# Optional. Google PageSpeed Insights API key (Core Web Vitals for key pages).
# Works without it at low volume; a key raises the quota.
PSI_API_KEY=
# Optional. Adds Perplexity (Sonar) to the AI visibility sample; Claude with
# web search is always used.
PERPLEXITY_API_KEY=
